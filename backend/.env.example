# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-too-a-different-long-random-string

# Database (MySQL)
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/burley_events

# SasaPay (sandbox first, swap to production values when ready)
SASAPAY_ENV=sandbox
SASAPAY_BASE_URL=https://sandbox.sasapay.app
SASAPAY_CLIENT_ID=your-client-id
SASAPAY_CLIENT_SECRET=your-client-secret
SASAPAY_MERCHANT_CODE=your-merchant-code
SASAPAY_CALLBACK_BASE_URL=https://your-public-domain-or-ngrok-url.com

# Margin policy
DEFAULT_MARKUP_PCT=35

# Cloudinary (image/video storage - required for uploads to persist on hosts
# like Render, whose local disk is wiped on every redeploy/restart)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS
FRONTEND_ORIGIN=http://localhost:5173
